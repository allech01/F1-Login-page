<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@drawable/main_background"
    >


    <ImageView
        android:id="@+id/c_logo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_alignParentEnd="true"
        android:src="@drawable/f1logo2"
        android:layout_margin="20dp" />


    <TextView
        android:id="@+id/welcome_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Forgot \nPassword"
        android:textColor="#FF4D4D"
        android:textStyle="bold"
        android:textSize="26sp"
        android:layout_marginLeft="17dp"
        android:layout_below="@+id/c_logo" />




    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:layout_below="@+id/welcome_2"
        android:layout_marginTop="40dp"
        android:background="@drawable/login_background"
        >
        <LinearLayout
            android:id="@+id/mailplusicon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginTop="10dp"
            android:weightSum="5"
            android:paddingTop="40dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/mailicon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="5.5dp"
                android:src="@drawable/mail"
                android:layout_weight="0.5" />

            <EditText
                android:id="@+id/email"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:hint="Email"
                android:textSize="18sp"
                android:inputType="textEmailAddress"
                android:textColor="#333333"
                android:background="@null"
                android:layout_weight="4" />
        </LinearLayout>

        <View
            android:id="@+id/line"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/mailplusicon"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:background="#333333" />



        <Button
            android:id="@+id/send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:layout_marginStart="0dp"
            android:layout_below="@+id/line"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"

            android:backgroundTint="@color/black"
            android:padding="15dp"
            android:text="SEND -> "
            android:textColor="#FF0000"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/not_account"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Don't have an Account?"
            android:layout_below="@+id/send"
            android:textSize="18sp"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="30dp"
            android:padding="0dp"
            android:layout_alignParentStart="true"
            android:textColor="@color/black" />

        <Button
            android:id="@+id/signup3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/white"
            android:text="Sign up"
            android:textColor="#ED0606"
            android:textSize="20sp"
            android:textStyle="bold"
            android:padding="0dp"
            android:layout_alignBaseline="@+id/not_account"
            android:layout_toEndOf="@id/not_account"
            android:layout_marginTop="10dp" />


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/signup3"
            android:layout_margin="20dp">

            <TextView
                android:id="@+id/or_continue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Or Continue With"
                android:textSize="18sp"
                android:layout_marginTop="20dp"
                android:layout_marginLeft="12dp"
                android:textColor="@color/black"
                android:layout_centerVertical="true" />



            <ImageView
                android:id="@+id/imagelinkdin"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/linkdein"
                android:layout_toStartOf="@+id/facebook"
                android:layout_centerVertical="true"
                android:layout_marginLeft="20dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="20dp" />
            <ImageView
                android:id="@+id/facebook"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/facebook"
                android:layout_toStartOf="@+id/google"
                android:layout_centerVertical="true"
                android:layout_marginRight="5dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="20dp" />

            <ImageView
                android:id="@+id/google"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/google"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="10dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="20dp"
                />
        </RelativeLayout>

        <ImageView
            android:id="@+id/carlogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="-4dp"
            android:layout_marginBottom="-340dp"
            android:src="@drawable/car" />

    </RelativeLayout>
</RelativeLayout>
